diff --git a/lib/CMakeLists.txt b/lib/CMakeLists.txt
index 0d5c1c5..eec67a6 100644
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -61,6 +61,11 @@ set_target_properties(k2pdfopt PROPERTIES
     VISIBILITY_INLINES_HIDDEN TRUE
 )
 target_compile_definitions(k2pdfopt PRIVATE BUILDING_LIBK2PDFOPT NO_FILELIST)
+if(WIN32)
+    # willuslib Win32 GUI/console helpers live in win*.c which we do not build;
+    # KOReader only needs the OCR/reflow subset. Force the UNIX paths instead.
+    target_compile_definitions(k2pdfopt PRIVATE NO_WIN32_API)
+endif()
 if(CMAKE_BUILD_TYPE STREQUAL "Debug")
     target_compile_definitions(k2pdfopt PRIVATE K2PDFOPT_DEBUG)
     target_sources(k2pdfopt PRIVATE
@@ -76,7 +81,12 @@ if(DISABLED_LEGACY_ENGINE)
     target_compile_definitions(k2pdfopt PRIVATE DISABLED_LEGACY_ENGINE)
 endif()
 target_include_directories(k2pdfopt PRIVATE ../k2pdfoptlib ../willuslib .)
-target_link_libraries(k2pdfopt PRIVATE m PkgConfig::Leptonica PkgConfig::Tesseract Threads::Threads)
+if(NOT WIN32)
+    target_link_libraries(k2pdfopt PRIVATE m)
+endif()
+# Static libtesseract pulls in many leptonica refs; leptonica must come after it
+# so MinGW ld --as-needed does not drop libleptonica.dll.a too early.
+target_link_libraries(k2pdfopt PRIVATE PkgConfig::Tesseract PkgConfig::Leptonica Threads::Threads)
 if(ANDROID)
     target_link_libraries(k2pdfopt PRIVATE log)
 endif()
